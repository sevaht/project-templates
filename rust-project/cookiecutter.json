{
    "author": "Your Name",
    "email": "your.email@example.com",
    "github_owner": "your-github-username",
    "project_name": "My Rust Project",
    "binary_name": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
    "crate_name": "{{ cookiecutter.binary_name.replace('-', '_') }}",
    "project_description": "A Rust project.",
    "project_type": ["application", "library"],
    "keywords": "{{ cookiecutter.project_name.lower().split()[:5] | join(', ') }}",
    "categories": "{{ 'command-line-utilities' if cookiecutter.project_type == 'application' else 'development-tools' }}",
    "license": [
        "Unlicense", "Apache-2.0", "GPL-3.0-only", "MIT",
        "BSD-2-Clause", "BSD-3-Clause", "BSL-1.0", "CC0-1.0", "EPL-2.0",
        "AGPL-3.0-only", "GPL-2.0-only", "LGPL-2.1-only", "MPL-2.0"
    ],
    "_extensions": ["template_extensions.SharedDirectoryExtension"],
    "copyright_year": "{% now 'utc', '%Y' %}",
    "rust_version": "1.85",
    "__prompts__": {
        "github_owner": "GitHub owner/org (used for the project URLs)",
        "binary_name": "Package and binary name (kebab-case)",
        "crate_name": "Crate name, as written in Rust code (snake_case)",
        "project_type": "Project type",
        "keywords": "crates.io keywords, comma-separated (at most 5)",
        "categories": "crates.io category slugs, comma-separated (https://crates.io/category_slugs)",
        "rust_version": "Minimum supported Rust version (the 2024 edition needs 1.85+)"
    }
}
