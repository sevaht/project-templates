{
    "author": "Your Name",
    "email": "your.email@example.com",
    "github_owner": "your-github-username",
    "project_name": "My Python Project",
    "binary_name": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
    "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '_') }}",
    "project_description": "A Python project.",
    "project_type": ["application", "library"],
    "gui": ["no", "yes"],
    "versioning": ["dynamic", "standard"],
    "license": [
        "Unlicense", "Apache-2.0", "GPL-3.0-only", "MIT",
        "BSD-2-Clause", "BSD-3-Clause", "BSL-1.0", "CC0-1.0", "EPL-2.0",
        "AGPL-3.0-only", "GPL-2.0-only", "LGPL-2.1-only", "MPL-2.0"
    ],
    "_extensions": ["template_extensions.SharedDirectoryExtension"],
    "copyright_year": "{% now 'utc', '%Y' %}",
    "python_version": "3.12",
    "max_line_length": 79,
    "_copy_without_render": ["*.yml"],
    "__prompts__": {
        "github_owner": "GitHub owner/org (used for the project URLs)",
        "project_type": "Project type",
        "gui": "Graphical (GUI) project? (only applies to applications)",
        "versioning": "Version source ('dynamic' uses git tags via hatch-vcs)"
    }
}
